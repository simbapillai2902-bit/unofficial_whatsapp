{
  "info": {
    "_postman_id": "whatsapp-campaign-api",
    "name": "WhatsApp Campaign Manager API",
    "description": "Complete API collection for WhatsApp multi-channel campaign manager",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health & Status",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": ["{{base_url}}"],
              "path": ["health"]
            },
            "description": "Check if API is running and healthy"
          },
          "response": []
        },
        {
          "name": "Ready Check (Dependencies)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/ready",
              "host": ["{{base_url}}"],
              "path": ["ready"]
            },
            "description": "Check if all dependencies (Database) are connected"
          },
          "response": []
        }
      ]
    },
    {
      "name": "WhatsApp Sessions",
      "item": [
        {
          "name": "Connect WhatsApp Session",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sessionName\": \"session1\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/whatsapp/connect",
              "host": ["{{base_url}}"],
              "path": ["api", "whatsapp", "connect"]
            },
            "description": "Create a new WhatsApp session and get QR code for scanning"
          },
          "response": []
        },
        {
          "name": "Get All Sessions",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/whatsapp/sessions",
              "host": ["{{base_url}}"],
              "path": ["api", "whatsapp", "sessions"]
            },
            "description": "Retrieve all WhatsApp sessions and their status"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Campaign Management",
      "item": [
        {
          "name": "Add Contacts to Campaign",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"campaign_id\": 1,\n  \"user_id\": 100,\n  \"contacts\": [\n    \"919876543210\",\n    \"911234567890\",\n    \"919988776655\"\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/campaign/add-contacts",
              "host": ["{{base_url}}"],
              "path": ["api", "campaign", "add-contacts"]
            },
            "description": "Add phone numbers to a campaign for bulk messaging"
          },
          "response": []
        },
        {
          "name": "Start Campaign",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"messageTemplate\": \"Hello, welcome to our campaign! This is a bulk message.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/campaign/campaign/start/1",
              "host": ["{{base_url}}"],
              "path": ["api", "campaign", "campaign", "start", "1"]
            },
            "description": "Start sending messages to all contacts in a campaign. Replace '1' with actual campaign ID"
          },
          "response": []
        },
        {
          "name": "Get Campaign Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/campaign/campaign/1/status",
              "host": ["{{base_url}}"],
              "path": ["api", "campaign", "campaign", "1", "status"]
            },
            "description": "Get real-time status of campaign message delivery. Replace '1' with actual campaign ID"
          },
          "response": []
        },
        {
          "name": "Get Job Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/campaign/job/campaign-1-1715755200000/status",
              "host": ["{{base_url}}"],
              "path": ["api", "campaign", "job", "campaign-1-1715755200000", "status"]
            },
            "description": "Get status of a specific job. Replace job ID with actual ID"
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5000",
      "type": "string"
    }
  ]
}
