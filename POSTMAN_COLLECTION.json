          "name": "1. Connect WhatsApp",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sessionName\": \"session1\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/whatsapp/connect",
              "host": ["{{base_url}}"],
              "path": ["api", "whatsapp", "connect"]
            }
          }
        },
        {
          "name": "2. Get All Sessions",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/whatsapp/sessions",
              "host": ["{{base_url}}"],
              "path": ["api", "whatsapp", "sessions"]
