            "body": {
              "mode": "raw",
              "raw": "{\n  \"sessionName\": \"session1\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/whatsapp/logout",
              "host": ["{{base_url}}"],
              "path": ["api", "whatsapp", "logout"]
            }
          }
        }
      ]
    },
