{
  "info": {
    "_postman_id": "multi-channel-api-collection-v2",
    "name": "NotifyNow Unofficial WhatsApp API",
    "description": "Complete API collection for WhatsApp sessions, templates, and campaign messaging on wa.notifynow.in.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://wa.notifynow.in",
      "type": "string"
    }
  ],
