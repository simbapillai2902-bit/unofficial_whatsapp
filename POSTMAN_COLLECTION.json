          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": 1,\n  \"template_name\": \"Welcome Promo\",\n  \"template_type\": \"plainText\",\n  \"template_content\": \"Hello {name}, welcome to our store!\",\n  \"variables\": [\"name\"],\n  \"preview_text\": \"Hello {{name}}, welcome to our store!\",\n  \"template_data\": {}\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/campaign/templates/save",
              "host": ["{{base_url}}"],
              "path": ["api", "campaign", "templates", "save"]
            }
          }
        },
